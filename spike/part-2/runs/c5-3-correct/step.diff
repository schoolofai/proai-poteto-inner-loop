@@ -0,0 +1,92 @@
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, expect, it } from 'vitest'
+import { App } from './App'
+import { StatusBadge } from './StatusBadge'
+import { SyncIndicator } from './SyncIndicator'
+
+afterEach(cleanup)
+
+it('renders compact classes immediately on every toggle', () => {
+  render(<App />)
+  const button = screen.getByRole('button', { name: 'Compact' })
+  const panel = screen.getByRole('main')
+  expect(button.previousElementSibling?.textContent).toBe('Priority only')
+  for (const active of [false, true, false, true]) {
+    if (active !== (button.getAttribute('aria-pressed') === 'true')) fireEvent.click(button)
+    expect(button.getAttribute('aria-pressed')).toBe(String(active))
+    expect(button.classList.contains('is-active')).toBe(active)
+    expect(panel.classList.contains('compact')).toBe(active)
+  }
+})
+
+it('renders priority highlighting immediately on and off', () => {
+  render(<App />)
+  const button = screen.getByRole('button', { name: 'Priority only' })
+  expect(button.classList.contains('is-active')).toBe(false)
+  for (const active of [true, false, true]) {
+    fireEvent.click(button)
+    expect(button.getAttribute('aria-pressed')).toBe(String(active))
+    expect(button.classList.contains('is-active')).toBe(active)
+  }
+})
+
+it('renders the selected folder highlight initially and after selection', () => {
+  render(<App />)
+  const inbox = screen.getByTestId('folder-inbox')
+  const sent = screen.getByTestId('folder-sent')
+  expect(inbox.classList.contains('is-active')).toBe(true)
+  expect(sent.classList.contains('is-active')).toBe(false)
+  fireEvent.click(sent)
+  expect(inbox.classList.contains('is-active')).toBe(false)
+  expect(sent.classList.contains('is-active')).toBe(true)
+  expect(sent.getAttribute('aria-current')).toBe('page')
+})
+
+it('renders unread styling from the current count', () => {
+  const { rerender } = render(<StatusBadge count={3} />)
+  const badge = screen.getByTestId('unread-badge')
+  expect(badge.classList.contains('has-unread')).toBe(true)
+  expect(badge.textContent).toBe('3')
+  rerender(<StatusBadge count={0} />)
+  expect(badge.classList.contains('has-unread')).toBe(false)
+  expect(badge.textContent).toBe('')
+  rerender(<StatusBadge count={12} />)
+  expect(badge.classList.contains('has-unread')).toBe(true)
+  expect(badge.textContent).toBe('9+')
+})
+
+it('renders sync styling from the current connection state', () => {
+  const { rerender } = render(<SyncIndicator online />)
+  const status = screen.getByRole('status')
+  expect(status.classList.contains('is-online')).toBe(true)
+  rerender(<SyncIndicator online={false} />)
+  expect(status.classList.contains('is-online')).toBe(false)
+  expect(status.textContent).toBe('Offline')
+  rerender(<SyncIndicator online />)
+  expect(status.classList.contains('is-online')).toBe(true)
+})
+
+it('renders focus styling immediately on focus and blur', () => {
+  render(<App />)
+  const input = screen.getByRole('searchbox')
+  expect(input.classList.contains('is-focused')).toBe(false)
+  fireEvent.focus(input)
+  expect(input.classList.contains('is-focused')).toBe(true)
+  fireEvent.blur(input)
+  expect(input.classList.contains('is-focused')).toBe(false)
+})
+
+it('keeps the selected view highlighted initially and after each switch', () => {
+  render(<App />)
+  const list = screen.getByRole('button', { name: 'List' })
+  const preview = screen.getByRole('button', { name: 'Preview' })
+  expect(list.classList.contains('is-active')).toBe(true)
+  expect(preview.classList.contains('is-active')).toBe(false)
+  for (const selected of [preview, list, preview]) {
+    fireEvent.click(selected)
+    for (const button of [list, preview]) {
+      expect(button.classList.contains('is-active')).toBe(button === selected)
+      expect(button.getAttribute('aria-pressed')).toBe(String(button === selected))
+    }
+  }
+})
