+type Props = {
+  active: boolean
+  onToggle: () => void
+}
+
+export function UnreadFilter({ active, onToggle }: Props) {
+  return (
+    <button
+      type="button"
+      className={active ? 'unread-filter is-active' : 'unread-filter'}
+      data-testid="unread-filter"
+      aria-pressed={active}
+      onClick={onToggle}
+    >
+      Unread only
+    </button>
+  )
+}
