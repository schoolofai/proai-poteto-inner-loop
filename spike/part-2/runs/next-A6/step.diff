--- /dev/null
+++ b/src/UnreadFilter.tsx
@@ -0,0 +1,27 @@
+import { useEffect, useRef } from 'react'
+import { deferVisualClass } from './deferVisualClass'
+
+type Props = {
+  active: boolean
+  onToggle: () => void
+}
+
+export function UnreadFilter({ active, onToggle }: Props) {
+  const ref = useRef<HTMLButtonElement>(null)
+
+  useEffect(() => {
+    return deferVisualClass(ref.current, 'is-active', active)
+  }, [active])
+
+  return (
+    <button
+      ref={ref}
+      type="button"
+      className="priority-filter"
+      aria-pressed={active}
+      onClick={onToggle}
+    >
+      Unread only
+    </button>
+  )
+}
